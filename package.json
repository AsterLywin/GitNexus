      },
      {
        "command": "gitnexus.worktreePrune",
        "title": "GitNexus: Worktree: Prune"
      },
      {
        "command": "gitnexus.worktreeOpen",
        "title": "GitNexus: Worktree: Open in New Window"
      },
      {
        "command": "gitnexus.fetchMoreHistory",
        "title": "GitNexus: Fetch More History"
      },
      {
        "command": "gitnexus.prList",
        "title": "GitNexus: Pull Requests: List Open"
      },
      {
        "command": "gitnexus.prStatus",
        "title": "GitNexus: Pull Requests: Status for Current Branch"
      },
      {
        "command": "gitnexus.prCreate",
        "title": "GitNexus: Pull Requests: Create"
      },
      {
        "command": "gitnexus.buildAiContext",
        "title": "GitNexus: AI Context: Build"
      },
      {
        "command": "gitnexus.copyAiContext",
        "title": "GitNexus: AI Context: Copy"
      },
      {
        "command": "gitnexus.blameToggle",
        "title": "GitNexus: Toggle Blame Annotations"
      },
      {
        "command": "gitnexus.copyHash",
        "title": "GitNexus: Copy Commit Hash"
      },
      {
        "command": "gitnexus.viewsRefresh",
        "title": "GitNexus: Refresh Views"
      },
      {
        "command": "gitnexus.copyHashFor",
        "title": "GitNexus: Copy Hash"
      },
      {
        "command": "gitnexus.checkoutRef",
        "title": "GitNexus: Checkout"
      },
      {
        "command": "gitnexus.createBranchFrom",
        "title": "GitNexus: Create Branch Here\u2026"
      },
      {
        "command": "gitnexus.deleteBranchItem",
        "title": "GitNexus: Delete Branch"
      },
      {
        "command": "gitnexus.deleteTagItem",
        "title": "GitNexus: Delete Tag"
      },
      {
        "command": "gitnexus.tagCreate",
        "title": "GitNexus: Create Tag\u2026"
      },
      {
        "command": "gitnexus.stashApplyItem",
        "title": "GitNexus: Apply Stash"
      },
      {
        "command": "gitnexus.stashPopItem",
        "title": "GitNexus: Pop Stash"
      },
      {
        "command": "gitnexus.stashDropItem",
        "title": "GitNexus: Drop Stash"
      },
      {
        "command": "gitnexus.remoteFetchItem",
        "title": "GitNexus: Fetch Remote"
      },
      {
        "command": "gitnexus.compareRefs",
        "title": "GitNexus: Compare Refs\u2026"
      },
      {
        "command": "gitnexus.searchCompareClear",
        "title": "GitNexus: Clear Search & Compare"
      },
      {
        "command": "gitnexus.generateCommitMessage",
        "title": "GitNexus: Generate Commit Message (AI)"
      },
      {
        "command": "gitnexus.explainCommit",
        "title": "GitNexus: Explain Commit (AI)"
      },
      {
        "command": "gitnexus.setGitLabToken",
        "title": "GitNexus: Set GitLab Token"
      },
      {
        "command": "gitnexus.setBitbucketCredentials",
        "title": "GitNexus: Set Bitbucket Credentials"
      }
    ],
    "configuration": {
      "title": "GitNexus",
      "properties": {
        "gitnexus.gitPath": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "gitnexus.gitTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Default timeout for Git commands."
        },
        "gitnexus.blame.currentLine.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show a blame annotation (author, relative time, summary) at the end of the current line."
        },
        "gitnexus.blame.gutter.heatmap": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Tint blamed lines by age when full-file blame annotations are enabled."
        },
        "gitnexus.blame.hover.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show a commit details card when hovering over a line."
        },
        "gitnexus.blame.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show file-level and per-function blame CodeLens."
        },
        "gitnexus.graph.showAvatars": {
          "type": "boolean",
          "default": true,
          "description": "Show Gravatar avatars in the commit graph."
        },
        "gitnexus.graph.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "Show the author column in the commit graph."
        },
        "gitnexus.graph.showDate": {
          "type": "boolean",
          "default": true,
          "description": "Show the date column in the commit graph."
        },
        "gitnexus.graph.showHash": {
          "type": "boolean",
          "default": false,
          "description": "Show the short hash column in the commit graph."
        },
        "gitnexus.autolinks": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "prefix",
              "url"
            ]
          },
          "description": "Autolink rules for commit text: references like PROJ-123 become links. The url may contain <num> for the reference id. GitHub #123 issue links are added automatically from the remote."
        },
        "gitnexus.pr.gitlabHosts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional self-hosted GitLab hostnames to recognize for merge requests (hosts containing 'gitlab' and gitlab.com are always recognized)."
        }
      }
    },
    "views": {
      "gitnexus": [
        {
          "id": "gitnexus.commits",
          "name": "Commits"
        },
        {
          "id": "gitnexus.branches",
          "name": "Branches"
        },
        {
          "id": "gitnexus.searchCompare",
          "name": "Search & Compare"
        },
        {
          "id": "gitnexus.tags",
          "name": "Tags"
        },
        {
          "id": "gitnexus.stashes",
          "name": "Stashes"
        },
        {
          "id": "gitnexus.remotes",
          "name": "Remotes"
        },
        {
          "id": "gitnexus.contributors",
          "name": "Contributors"
        },
        {
          "id": "gitnexus.worktrees",
          "name": "GitNexus Worktrees"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitnexus.worktreeAdd",
          "when": "view == gitnexus.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.worktreePrune",
          "when": "view == gitnexus.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "gitnexus.refreshRepository",
          "when": "view == gitnexus.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "gitnexus.viewsRefresh",
          "when": "view == gitnexus.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.branchCreate",
          "when": "view == gitnexus.branches",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.viewsRefresh",
          "when": "view == gitnexus.branches",
          "group": "navigation@2"
        },
        {
          "command": "gitnexus.tagCreate",
          "when": "view == gitnexus.tags",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.viewsRefresh",
          "when": "view == gitnexus.tags",
          "group": "navigation@2"
        },
        {
          "command": "gitnexus.stashPush",
          "when": "view == gitnexus.stashes",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.viewsRefresh",
          "when": "view == gitnexus.stashes",
          "group": "navigation@2"
        },
        {
          "command": "gitnexus.viewsRefresh",
          "when": "view == gitnexus.remotes",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.viewsRefresh",
          "when": "view == gitnexus.contributors",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.searchCommits",
          "when": "view == gitnexus.searchCompare",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.compareRefs",
          "when": "view == gitnexus.searchCompare",
          "group": "navigation@2"
        },
        {
          "command": "gitnexus.searchCompareClear",
          "when": "view == gitnexus.searchCompare",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitnexus.worktreeOpen",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@1"
        },
        {
          "command": "gitnexus.worktreeMove",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree(?!Main)/",
          "group": "2_edit@1"
        },
        {
          "command": "gitnexus.worktreeRemove",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree(?!Main)/",
          "group": "2_edit@2"
        },
        {
          "command": "gitnexus.worktreeLock",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree(Main)?$/",
          "group": "2_edit@3"
        },
        {
          "command": "gitnexus.worktreeUnlock",
          "when": "view == gitnexus.worktrees && viewItem =~ /Locked$/",
          "group": "2_edit@4"
        },
        {
          "command": "gitnexus.checkoutRef",
          "when": "view == gitnexus.commits && viewItem == commit",
          "group": "1_checkout@1"
        },
        {
          "command": "gitnexus.createBranchFrom",
          "when": "view == gitnexus.commits && viewItem == commit",
          "group": "1_checkout@2"
        },
        {
          "command": "gitnexus.copyHashFor",
          "when": "view == gitnexus.commits && viewItem == commit",
          "group": "2_copy@1"
        },
        {
          "command": "gitnexus.checkoutRef",
          "when": "view == gitnexus.branches && viewItem == branchLocal",
          "group": "1_checkout@1"
        },
        {
          "command": "gitnexus.checkoutRef",
          "when": "view == gitnexus.branches && viewItem == branchRemote",
          "group": "1_checkout@1"
        },
        {
          "command": "gitnexus.createBranchFrom",
          "when": "view == gitnexus.branches && viewItem =~ /^branch/",
          "group": "1_checkout@2"
        },
        {
          "command": "gitnexus.deleteBranchItem",
          "when": "view == gitnexus.branches && viewItem == branchLocal",
          "group": "3_edit@1"
        },
        {
          "command": "gitnexus.checkoutRef",
          "when": "view == gitnexus.tags && viewItem == tag",
          "group": "1_checkout@1"
        },
        {
          "command": "gitnexus.createBranchFrom",
          "when": "view == gitnexus.tags && viewItem == tag",
          "group": "1_checkout@2"
        },
        {
          "command": "gitnexus.deleteTagItem",
          "when": "view == gitnexus.tags && viewItem == tag",
          "group": "3_edit@1"
        },
        {
          "command": "gitnexus.stashApplyItem",
          "when": "view == gitnexus.stashes && viewItem == stash",
          "group": "1_stash@1"
        },
        {
          "command": "gitnexus.stashPopItem",
          "when": "view == gitnexus.stashes && viewItem == stash",
          "group": "1_stash@2"
        },
        {
          "command": "gitnexus.stashDropItem",
          "when": "view == gitnexus.stashes && viewItem == stash",
          "group": "1_stash@3"
        },
        {
          "command": "gitnexus.remoteFetchItem",
          "when": "view == gitnexus.remotes && viewItem == remote",
          "group": "1_remote@1"
        },
        {
          "command": "gitnexus.checkoutRef",
          "when": "view == gitnexus.searchCompare && viewItem == commit",
          "group": "1_checkout@1"
        },
        {
          "command": "gitnexus.createBranchFrom",
          "when": "view == gitnexus.searchCompare && viewItem == commit",
          "group": "1_checkout@2"
        },
        {
          "command": "gitnexus.copyHashFor",
          "when": "view == gitnexus.searchCompare && viewItem == commit",
          "group": "2_copy@1"
        },
        {
          "command": "gitnexus.explainCommit",
          "when": "(view == gitnexus.commits || view == gitnexus.searchCompare) && viewItem == commit",
          "group": "4_ai@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitnexus.copyHash",
          "when": "false"
        },
        {
          "command": "gitnexus.copyHashFor",
          "when": "false"
        },
        {
          "command": "gitnexus.checkoutRef",
          "when": "false"
        },
        {
          "command": "gitnexus.createBranchFrom",
          "when": "false"
        },
        {
          "command": "gitnexus.deleteBranchItem",
          "when": "false"
        },
        {
          "command": "gitnexus.deleteTagItem",
          "when": "false"
        },
        {
          "command": "gitnexus.stashApplyItem",
          "when": "false"
        },
        {
          "command": "gitnexus.stashPopItem",
          "when": "false"
        },
        {
          "command": "gitnexus.stashDropItem",
          "when": "false"
        },
        {
          "command": "gitnexus.remoteFetchItem",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "gitnexus.blameToggle",
          "group": "1_modification",
          "when": "resourceScheme == file"
        }
      ],
      "scm/title": [
        {
          "command": "gitnexus.generateCommitMessage",
          "when": "scmProvider == gitnexus",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitnexus",
          "title": "GitNexus",
          "icon": "media/gitnexus.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node scripts/run-tests.mjs",
    "package": "npm run build && npx @vscode/vsce package",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
