{
  "name": "gitnexus",
  "displayName": "GitNexus",
  "description": "Open-source, local-first Git intelligence for VS Code.",
  "version": "1.5.0",
  "publisher": "gitnexus",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
