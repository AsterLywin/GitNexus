{
  "name": "gitnexus",
  "displayName": "GitNexus",
  "description": "Open-source, local-first Git intelligence for VS Code.",
  "version": "1.0.4",
  "publisher": "gitnexus",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitnexus/gitnexus"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:gitnexus.branchCreate",
    "onCommand:gitnexus.branchList",
    "onCommand:gitnexus.openGraph",
    "onCommand:gitnexus.rebasePlan",
    "onCommand:gitnexus.refreshRepository",
    "onCommand:gitnexus.showStatus",
    "onCommand:gitnexus.stage",
    "onCommand:gitnexus.unstage",
    "onStartupFinished",
    "onCommand:gitnexus.openDiff",
    "onCommand:gitnexus.discard",
    "onCommand:gitnexus.commit",
    "onCommand:gitnexus.branchDelete",
    "onCommand:gitnexus.branchRename",
    "onCommand:gitnexus.stashPush",
    "onCommand:gitnexus.stashList",
    "onCommand:gitnexus.openConflicts",
    "onCommand:gitnexus.operationContinue",
    "onCommand:gitnexus.operationSkip",
    "onCommand:gitnexus.operationAbort",
    "onCommand:gitnexus.rebaseSkip",
    "onCommand:gitnexus.rebaseEditTodo",
    "onCommand:gitnexus.worktreeAdd",
    "onCommand:gitnexus.worktreeRemove",
    "onCommand:gitnexus.worktreeMove",
    "onCommand:gitnexus.worktreeLock",
    "onCommand:gitnexus.worktreeUnlock",
    "onCommand:gitnexus.worktreePrune",
    "onCommand:gitnexus.worktreeOpen",
    "onCommand:gitnexus.openRebasePlanner",
    "onCommand:gitnexus.graphNextMatch",
    "onCommand:gitnexus.graphPreviousMatch",
    "onView:gitnexus.worktrees",
    "onCommand:gitnexus.fetchMoreHistory",
    "onCommand:gitnexus.prList",
    "onCommand:gitnexus.prStatus",
    "onCommand:gitnexus.prCreate",
    "onCommand:gitnexus.buildAiContext",
    "onCommand:gitnexus.copyAiContext"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitnexus.openGraph",
        "title": "GitNexus: Open Commit Graph"
      },
      {
        "command": "gitnexus.refreshRepository",
        "title": "GitNexus: Refresh Repository"
      },
      {
        "command": "gitnexus.showStatus",
        "title": "GitNexus: Show Status"
      },
      {
        "command": "gitnexus.showCommit",
        "title": "GitNexus: Show Commit"
      },
      {
        "command": "gitnexus.fileHistory",
        "title": "GitNexus: File History"
      },
      {
        "command": "gitnexus.compare",
        "title": "GitNexus: Compare Refs"
      },
      {
        "command": "gitnexus.searchCommits",
        "title": "GitNexus: Search Commits"
      },
      {
        "command": "gitnexus.rebaseContinue",
        "title": "GitNexus: Rebase Continue"
      },
      {
        "command": "gitnexus.rebaseAbort",
        "title": "GitNexus: Rebase Abort"
      },
      {
        "command": "gitnexus.listWorktrees",
        "title": "GitNexus: Worktrees"
      },
      {
        "command": "gitnexus.rebaseStart",
        "title": "GitNexus: Start Interactive Rebase"
      },
      {
        "command": "gitnexus.rebaseStatus",
        "title": "GitNexus: Rebase Status"
      },
      {
        "command": "gitnexus.stage",
        "title": "GitNexus: Stage File"
      },
      {
        "command": "gitnexus.unstage",
        "title": "GitNexus: Unstage File"
      },
      {
        "command": "gitnexus.branchList",
        "title": "GitNexus: Switch Branch"
      },
      {
        "command": "gitnexus.branchCreate",
        "title": "GitNexus: Create Branch"
      },
      {
        "command": "gitnexus.rebasePlan",
        "title": "GitNexus: Rebase Planner"
      },
      {
        "command": "gitnexus.openRebasePlanner",
        "title": "GitNexus: Open Interactive Rebase Planner"
      },
      {
        "command": "gitnexus.openConflicts",
        "title": "GitNexus: Open Conflict Resolver"
      },
      {
        "command": "gitnexus.openDiff",
        "title": "GitNexus: Open File Diff"
      },
      {
        "command": "gitnexus.discard",
        "title": "GitNexus: Discard File Changes"
      },
      {
        "command": "gitnexus.commit",
        "title": "GitNexus: Commit Staged Changes"
      },
      {
        "command": "gitnexus.branchDelete",
        "title": "GitNexus: Delete Branch"
      },
      {
        "command": "gitnexus.branchRename",
        "title": "GitNexus: Rename Branch"
      },
      {
        "command": "gitnexus.stashPush",
        "title": "GitNexus: Stash Changes"
      },
      {
        "command": "gitnexus.stashList",
        "title": "GitNexus: Stash List"
      },
      {
        "command": "gitnexus.graphNextMatch",
        "title": "GitNexus: Graph Next Match"
      },
      {
        "command": "gitnexus.graphPreviousMatch",
        "title": "GitNexus: Graph Previous Match"
      },
      {
        "command": "gitnexus.operationContinue",
        "title": "GitNexus: Operation: Continue"
      },
      {
        "command": "gitnexus.operationSkip",
        "title": "GitNexus: Operation: Skip"
      },
      {
        "command": "gitnexus.operationAbort",
        "title": "GitNexus: Operation: Abort"
      },
      {
        "command": "gitnexus.rebaseSkip",
        "title": "GitNexus: Rebase: Skip"
      },
      {
        "command": "gitnexus.rebaseEditTodo",
        "title": "GitNexus: Rebase: Edit Todo (In Progress)"
      },
      {
        "command": "gitnexus.worktreeAdd",
        "title": "GitNexus: Worktree: Add"
      },
      {
        "command": "gitnexus.worktreeRemove",
        "title": "GitNexus: Worktree: Remove"
      },
      {
        "command": "gitnexus.worktreeMove",
        "title": "GitNexus: Worktree: Move"
      },
      {
        "command": "gitnexus.worktreeLock",
        "title": "GitNexus: Worktree: Lock"
      },
      {
        "command": "gitnexus.worktreeUnlock",
        "title": "GitNexus: Worktree: Unlock"
      },
      {
        "command": "gitnexus.worktreePrune",
        "title": "GitNexus: Worktree: Prune"
      },
      {
        "command": "gitnexus.worktreeOpen",
        "title": "GitNexus: Worktree: Open in New Window"
      },
      {
        "command": "gitnexus.fetchMoreHistory",
        "title": "GitNexus: Fetch More History"
      },
      {
        "command": "gitnexus.prList",
        "title": "GitNexus: Pull Requests: List Open"
      },
      {
        "command": "gitnexus.prStatus",
        "title": "GitNexus: Pull Requests: Status for Current Branch"
      },
      {
        "command": "gitnexus.prCreate",
        "title": "GitNexus: Pull Requests: Create"
      },
      {
        "command": "gitnexus.buildAiContext",
        "title": "GitNexus: AI Context: Build"
      },
      {
        "command": "gitnexus.copyAiContext",
        "title": "GitNexus: AI Context: Copy"
      }
    ],
    "configuration": {
      "title": "GitNexus",
      "properties": {
        "gitnexus.gitPath": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "gitnexus.gitTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Default timeout for Git commands."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "gitnexus.worktrees",
          "name": "GitNexus Worktrees"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitnexus.worktreeAdd",
          "when": "view == gitnexus.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "gitnexus.worktreePrune",
          "when": "view == gitnexus.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "gitnexus.refreshRepository",
          "when": "view == gitnexus.worktrees",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitnexus.worktreeOpen",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree/",
          "group": "1_open@1"
        },
        {
          "command": "gitnexus.worktreeMove",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree(?!Main)/",
          "group": "2_edit@1"
        },
        {
          "command": "gitnexus.worktreeRemove",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree(?!Main)/",
          "group": "2_edit@2"
        },
        {
          "command": "gitnexus.worktreeLock",
          "when": "view == gitnexus.worktrees && viewItem =~ /^worktree(Main)?$/",
          "group": "2_edit@3"
        },
        {
          "command": "gitnexus.worktreeUnlock",
          "when": "view == gitnexus.worktrees && viewItem =~ /Locked$/",
          "group": "2_edit@4"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node scripts/run-tests.mjs",
    "package": "npm run build && npx @vscode/vsce package",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
